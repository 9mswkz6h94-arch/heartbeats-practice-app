{
  "characterId": "ringlet",
  "version": 1,
  "voice": {
    "traits": ["attentive", "curious", "calm", "warm"],
    "avoid": ["pressure", "accuracy_claims", "comparisons", "guilt"]
  },
  "intents": {
    "session_welcome": {
      "templates": ["{opener} {welcome}"],
      "opener": ["Hey!", "Ready to listen?", "I hear something good."],
      "welcome": ["Let's listen for today's practice.", "Let's tune in to the first card.", "One careful listen starts everything."]
    },
    "step_complete_generic": {
      "templates": ["{celebration} {completion}"],
      "celebration": ["Nice!", "Well heard!", "That caught my ear!", "Good noticing!", "Great work!", "You heard that through!"],
      "completion": ["That card is done.", "On to the next sound.", "The practice keeps going.", "That's one more behind you.", "You listened all the way through.", "Note by note, it adds up.", "That part can rest now.", "You finished that piece of practice."]
    },
    "step_complete_scales": {
      "templates": ["{celebration} {scale_finish}"],
      "celebration": ["Nice climbing!", "Well tuned!", "Great work!", "That scale rang clearly!"],
      "scale_finish": ["Those scales are finished.", "You followed that scale all the way through.", "The notes made it home.", "That ladder of notes came through clearly."]
    },
    "remaining_count": {
      "templates": ["{remainingCount} {noun} {ending}"],
      "noun": ["more cards", "more practice pieces", "more musical stops"],
      "ending": ["when you're ready.", "left for today.", "and then today's set is complete."]
    },
    "halfway_today": {
      "templates": ["Halfway through today's practice.", "You're at the middle of today's set.", "Half the cards are already finished."]
    },
    "last_item": {
      "templates": ["One card left when you're ready.", "One more sound to listen for today.", "The last card is waiting for you."]
    },
    "session_complete": {
      "templates": ["You finished today's practice!", "Every card is complete. Well heard!", "Today's listening is complete!", "That's the whole practice set. You did it!"]
    },
    "return_after_break": {
      "templates": ["I'm glad you're here.", "A new sound can start anytime.", "Ready when you are.", "Let's listen for what's next."]
    },
    "skip_accepted": {
      "templates": ["Saved for another day.", "We can come back to that one.", "That card can wait.", "Good choice. Let's keep moving."]
    },
    "listening_started": {
      "templates": ["I'll listen closely while you play!", "My ears are ready!", "Let's hear something together!"]
    },
    "listening_stopped": {
      "templates": ["That was lovely!", "Thanks for playing for me.", "My ears are still humming that tune."]
    }
  }
}
