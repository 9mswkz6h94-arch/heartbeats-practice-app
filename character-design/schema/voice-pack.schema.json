{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainbowheart.studio/schemas/musical-zoo-voice-pack-v1.json",
  "title": "Musical Zoo authored companion voice pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["characterId", "version", "voice", "intents"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "characterId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traits", "avoid"],
      "properties": {
        "traits": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "avoid": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    },
    "intents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["session_welcome", "step_complete_generic", "step_complete_warmup", "step_complete_scales", "step_complete_theory", "step_complete_piece", "remaining_count", "halfway_today", "last_item", "session_complete", "return_after_break", "skip_accepted", "badge_unlocked", "song_memorized", "pet_growth", "egg_earned", "habitat_unlocked", "sticker_received", "friend_practiced_digest", "share_practice_prompt", "listening_started", "listening_stopped", "network_retry"] },
      "additionalProperties": { "$ref": "#/$defs/intent" }
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "intent": {
      "type": "object",
      "required": ["templates"],
      "properties": { "templates": { "$ref": "#/$defs/nonEmptyUniqueStrings" } },
      "additionalProperties": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
    }
  }
}
