{
  "name": "heartbeats-practice-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "pitchy": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "tonal": "^6.4.3",
    "vexflow": "^5.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "zoo:build-art": "node concept-art/library-expansion/three-format-v1/build-all.cjs",
    "zoo:build-correction-candidates": "node concept-art/library-expansion/three-format-v1/build-correction-candidates-v2.cjs",
    "zoo:stage-app-art": "node concept-art/library-expansion/three-format-v1/stage-app-assets.cjs",
    "zoo:validate-art": "node concept-art/library-expansion/three-format-v1/validate-three-format.cjs",
    "zoo:new-character": "node concept-art/library-expansion/three-format-v1/scaffold-character.cjs",
    "release:check-migrations": "node scripts/check-release-migrations.cjs",
    "release:validate": "npm run release:check-migrations && npm run zoo:validate-art && npm test -- --watchAll=false --runInBand && npm run build",
    "staging:check-env": "node scripts/check-staging-env.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "supabase": "^2.109.1"
  }
}
